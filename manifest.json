{
  "manifest_version": 3,
  "name": "Sona — Read Aloud",
  "version": "1.3.0",
  "minimum_chrome_version": "124",
  "description": "Listen to articles and selected or pasted text with a bundled offline voice, sentence highlights, and a floating player.",
  "permissions": ["activeTab", "scripting", "storage", "tts", "contextMenus", "offscreen", "sidePanel"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sona · Listen to this page",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": { "default_path": "reader.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the Sona reader"
    },
    "toggle-playback": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume reading"
    },
    "previous-sentence": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "Read the previous sentence"
    },
    "next-sentence": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "Read the next sentence"
    }
  }
}
