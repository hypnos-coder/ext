{
  "manifest_version": 3,
  "name": "Sona — Read Aloud",
  "version": "1.4.0",
  "minimum_chrome_version": "124",
  "description": "Read webpages, embedded PDFs, and scanned documents aloud with local OCR, an offline voice, highlights, and reading controls.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "tts", "contextMenus", "offscreen", "sidePanel", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["vendor/readability/Readability.js", "content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sona · Listen to this page",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": { "default_path": "reader.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the Sona reader"
    },
    "toggle-playback": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume reading"
    },
    "previous-sentence": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "Read the previous sentence"
    },
    "next-sentence": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "Read the next sentence"
    }
  }
}
